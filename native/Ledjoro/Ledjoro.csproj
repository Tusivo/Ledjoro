<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Ledjoro</AssemblyName>
    <RootNamespace>Ledjoro</RootNamespace>
    <Version>0.9.2-beta.1</Version>
    <AssemblyVersion>0.9.2.0</AssemblyVersion>
    <FileVersion>0.9.2.1</FileVersion>
    <InformationalVersion>0.9.2-beta.1</InformationalVersion>
    <Product>Ledjoro</Product>
  </PropertyGroup>
  <!-- The camera (for scanning the recovery QR code) uses Windows' own camera API. It is compiled in only when the Windows SDK metadata file is found;
       otherwise the "Scan" button just does not appear. Nothing extra is shipped: the exe stays one file. -->
  <PropertyGroup>
    <SdkMeta>$(MSBuildProgramFiles32)\Windows Kits\10\UnionMetadata</SdkMeta>
    <WinMdFile Condition="Exists('$(SdkMeta)\10.0.26100.0\Windows.winmd')">$(SdkMeta)\10.0.26100.0\Windows.winmd</WinMdFile>
    <WinMdFile Condition="'$(WinMdFile)' == '' And Exists('$(SdkMeta)\10.0.22621.0\Windows.winmd')">$(SdkMeta)\10.0.22621.0\Windows.winmd</WinMdFile>
    <WinMdFile Condition="'$(WinMdFile)' == '' And Exists('$(SdkMeta)\10.0.19041.0\Windows.winmd')">$(SdkMeta)\10.0.19041.0\Windows.winmd</WinMdFile>
    <WinMdFile Condition="'$(WinMdFile)' == '' And Exists('$(SdkMeta)\10.0.17763.0\Windows.winmd')">$(SdkMeta)\10.0.17763.0\Windows.winmd</WinMdFile>
    <WinRtFacade>$(WINDIR)\Microsoft.NET\Framework\v4.0.30319\System.Runtime.WindowsRuntime.dll</WinRtFacade>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WinMdFile)' != '' And Exists('$(WinRtFacade)')">
    <DefineConstants>$(DefineConstants);HAS_WINRT_CAMERA</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(WinMdFile)' != '' And Exists('$(WinRtFacade)')">
    <Reference Include="Windows"><HintPath>$(WinMdFile)</HintPath><IsWinMDFile>true</IsWinMDFile><Private>false</Private></Reference>
    <Reference Include="System.Runtime.WindowsRuntime"><HintPath>$(WinRtFacade)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <PropertyGroup Condition="'$(IconPath)' != ''">
    <ApplicationIcon>$(IconPath)</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <EmbeddedResource Include="..\..\README.md" LogicalName="readme.md" />
    <EmbeddedResource Include="release-key.txt" LogicalName="release-key.txt" Condition="Exists('release-key.txt')" />   <!-- the public key updates must be signed with (made by: node scripts/release-sign.js keygen) -->   <!-- the About page shows an excerpt of it -->
  </ItemGroup>
  <!-- scripts/build-native.js passes these: the engine executable and its SHA-256 are embedded so Ledjoro.exe is a single file. -->
  <ItemGroup Condition="'$(EnginePath)' != ''">
    <EmbeddedResource Include="$(EnginePath)" LogicalName="engine.exe" />
    <EmbeddedResource Include="$(EngineHashFile)" LogicalName="engine.sha256" />
  </ItemGroup>
</Project>
